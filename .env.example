# MongoDB connection string (local: mongodb://127.0.0.1:27017/aperture, or an Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/aperture
# Database name used when the URI does not already include one.
MONGODB_DB=aperture
# LLM layer (M4). Either a local Ollama endpoint or an OpenAI-compatible API.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
